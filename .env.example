# ============================================
# PocketAI — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit real tokens to GitHub
# ============================================

# ── GitHub ──────────────────────────────────
# Needed for: pushing code + uploading release assets
# Get from: https://github.com/settings/tokens (scopes: repo, write:packages)
GH_REPO=junaidshah9826650092-cmyk/PocketModel-Lab
GH_TOKEN=ghp_your_github_personal_access_token_here

# ── Hugging Face ────────────────────────────
# Needed for: uploading GGUF models + README
# Get from: https://huggingface.co/settings/tokens (scope: write)
HF_REPO_ID=junaiidshah78634/PocketModel-Lab
HF_TOKEN=hf_your_huggingface_write_token_here

# ── Optional: Gemini Web2API (teacher model) ──
# Needed if you use gemini-web2api for synthetic data generation
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: Other Providers ───────────────
# OpenAI (if using GPT as teacher)
OPENAI_API_KEY=sk-your_openai_key_here

# Anthropic (if using Claude as teacher)
ANTHROPIC_API_KEY=sk-ant-your_claude_key_here

# Groq (fast inference)
GROQ_API_KEY=gsk_your_groq_key_here

# xAI
XAI_API_KEY=xai-your_xai_key_here

# ── Colab / Runtime ─────────────────────────
# Leave these blank unless you need them
CUDA_VISIBLE_DEVICES=0
HF_HUB_ENABLE_HF_TRANSFER=1

# ============================================
# How to use in Colab:
# 1. Create a new cell at the top
# 2. Paste: %env GH_TOKEN=your_token
# 3. Paste: %env HF_TOKEN=your_token
# 4. OR use: from getpass import getpass; GH_TOKEN = getpass()
# ============================================
